# Copie a .env y ajuste. Nunca suba .env al repositorio.
ENVIRONMENT=development            # development | test | production
DATABASE_URL=postgresql+psycopg://sorteo:sorteo@localhost:5432/sorteo

# Autenticación: local (JWT propio) o supabase
AUTH_PROVIDER=local
JWT_SECRET=genere-uno-con-python-c-import-secrets-print-secrets.token_hex(32)
ACCESS_TOKEN_MINUTES=720
# Solo si AUTH_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated

CORS_ORIGINS=http://localhost:5173
AUTO_PUBLISH_ON_NEW_DATA=true
MAX_UPLOAD_MB=20

# IA opcional (fase futura). 'none' = desactivada. Ninguna funcionalidad depende de ella.
ASSISTANT_PROVIDER=none

# Frontend (Vite)
VITE_API_URL=http://localhost:8000
